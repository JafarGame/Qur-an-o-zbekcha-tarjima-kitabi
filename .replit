modules = ["nodejs-20", "python-base-3.13"]

[env]
ANDROID_HOME = "/home/runner/workspace/android-sdk"
JAVA_HOME = "/nix/store/2ds1jrzlmx4n08sp7flga5sxf000l2sl-zulu-ca-jdk-21.0.4"

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["zulu21"]

[workflows]
runButton = "Quran Web"

[[workflows.workflow]]
name = "Quran Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node web-server.js"
waitForPort = 5000

[[workflows.workflow.ports]]
localPort = 5000
externalPort = 80

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["node", "web-server.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.shared]
APK_DOWNLOAD_URL = "https://github.com/JafarGame/Qur-an-o-zbekcha-tarjima-kitabi/releases/download/v1.0-apk/quran-karim.apk"
