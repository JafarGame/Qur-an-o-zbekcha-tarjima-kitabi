modules = ["nodejs-20", "python-base-3.13"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Quran Web"

[[workflows.workflow]]
name = "Quran Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node web-server.js"
waitForPort = 5000

[[workflows.workflow.ports]]
localPort = 5000
externalPort = 80

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["node", "web-server.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
